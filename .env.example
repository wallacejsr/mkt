# GEMINI_API_KEY: Required for Gemini AI API calls.
## GEMINI_MODEL is optional; update it when Google changes the recommended model.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SUPABASE / POSTGRES DATABASE URL
# Transaction Pooler connection string for Vercel/Serverless (Port 6543)
# Example: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:your-password@db.your-supabase-ref.supabase.co:5432/postgres"

# Optional legacy discrete SQL credentials (if not using DATABASE_URL)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# RESEND: provedor de e-mail das campanhas de prospecção.
# Use um subdomínio autenticado no Resend, por exemplo mail.seudominio.com.br.
RESEND_API_KEY=""
# Segredo de assinatura do webhook criado no painel do Resend (começa com whsec_).
RESEND_WEBHOOK_SECRET=""
# Segredo usado pelo agendador para chamar o worker. Gere uma sequência aleatória com 32+ caracteres.
CRON_SECRET=""
EMAIL_FROM_NAME="AGRO BW"
EMAIL_FROM_ADDRESS="contato@mail.seudominio.com.br"
# Opcional: endereço que receberá as respostas dos destinatários.
EMAIL_REPLY_TO=""

# GEOAPIFY_API_KEY: Primary API key for Geoapify Places B2B discovery.
GEOAPIFY_API_KEY=""

# GOOGLE_PLACES_API_KEY: Optional API key for Google Places B2B discovery.
GOOGLE_PLACES_API_KEY=""
